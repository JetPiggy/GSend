{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsend",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  // Cloudflare creates the DNS record and the certificate for this on deploy.
  "routes": [{ "pattern": "gsend.cc", "custom_domain": true }],
  // gsend.cc is the only address. The workers.dev one was kept as a way past corporate
  // filters that blocked the new domain; they let it through now, and that address
  // carries the account's personal subdomain. Preview URLs live there too.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Signalling must reach the Worker even though the SPA fallback matches everything.
    "run_worker_first": ["/api/*", "/share"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionRoom" },
      { "name": "DEVICE_GROUP", "class_name": "DeviceGroup" },
      { "name": "JOIN_GUARD", "class_name": "JoinGuard" },
      { "name": "METRICS", "class_name": "Metrics" }
    ]
  },
  "migrations": [
    {
      // SQLite-backed classes are the ones available on the free plan.
      "tag": "v1",
      "new_sqlite_classes": ["SessionRoom", "JoinGuard"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Metrics"]
    },
    {
      // The rendezvous room for paired devices. It holds only cached relay
      // credentials, which its own alarm clears once they expire.
      "tag": "v3",
      "new_sqlite_classes": ["DeviceGroup"]
    }
  ],
  // Off on purpose. Workers Logs would keep every request's URL and headers, the IP
  // address included, for days, and the privacy page says the IP is never written
  // down. `npx wrangler tail` still streams live logs, without storing them.
  "observability": { "enabled": false }
}
